   "source": [
    "import tensorflow as tf\n",
    "import os\n",
    "\n",
    "# 64 samples per GPU batch; lower to 32 if you get an out-of-memory error\n",
    "IMG_SIZE = (224, 224)\n",
    "BATCH_SIZE = 32\n",
    "AUTOTUNE = tf.data.AUTOTUNE\n",
    "\n",
    "train_ds = tf.keras.utils.image_dataset_from_directory(\n",
    "    os.path.join(BASE_PATH, 'train'),\n",
    "    image_size=IMG_SIZE,\n",
    "    batch_size=BATCH_SIZE,\n",
    "    label_mode='binary',\n",
    "    color_mode='rgb',\n",
    "    shuffle=True,\n",
    "    seed=42\n",
    ")\n",
    "\n",
    "val_ds = tf.keras.utils.image_dataset_from_directory(\n",
    "    os.path.join(BASE_PATH, 'val'),\n",
    "    image_size=IMG_SIZE,\n",
    "    batch_size=BATCH_SIZE,\n",
    "    label_mode='binary',\n",
    "    color_mode='rgb',\n",
    "    shuffle=False\n",
    ")\n",
    "\n",
    "test_ds = tf.keras.utils.image_dataset_from_directory(\n",
    "    os.path.join(BASE_PATH, 'test'),\n",
    "    image_size=IMG_SIZE,\n",
    "    batch_size=BATCH_SIZE,\n",
    "    label_mode='binary',\n",
    "    color_mode='rgb',\n",
    "    shuffle=False\n",
    ")\n",
    "\n",
    "augment = tf.keras.Sequential([\n",
    "    tf.keras.layers.RandomFlip('horizontal'),\n",
    "    tf.keras.layers.RandomRotation(10 / 360),\n",
    "    tf.keras.layers.RandomZoom(0.1),\n",
    "    tf.keras.layers.RandomTranslation(0.05, 0.05),\n",
    "], name='augmentation')\n",
    "\n",
    "normalize = tf.keras.layers.Rescaling(1.0 / 255)\n",
    "\n",
    "def prepare_training(ds):\n",
    "    ds = ds.map(lambda x, y: (normalize(x), y), num_parallel_calls=AUTOTUNE)\n",
    "    ds = ds.cache()\n",
    "    ds = ds.shuffle(1000)\n",
    "    ds = ds.map(lambda x, y: (augment(x, training=True), y), num_parallel_calls=AUTOTUNE)\n",
    "    return ds.prefetch(AUTOTUNE)\n",
    "\n",
    "def prepare_validation(ds):\n",
    "    ds = ds.map(lambda x, y: (normalize(x), y), num_parallel_calls=AUTOTUNE)\n",
    "    ds = ds.cache()\n",
    "    return ds.prefetch(AUTOTUNE)\n",
    "\n",
    "train_ds = prepare_training(train_ds)\n",
    "val_ds = prepare_validation(val_ds)\n",
    "test_ds = prepare_validation(test_ds)\n",
    "\n",
    "print(\"Optimized tf.data pipeline ready at batch size\", BATCH_SIZE)"
   ]
  },
